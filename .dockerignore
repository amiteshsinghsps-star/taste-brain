# Never send secrets or local state into a build context.
server/.env
server/.env.*
server/.private-cache/
server/.private-cache-test/
server/.private-data/
**/*.log

# Rebuilt inside the image.
**/node_modules/
client/dist/
server/dist/
server/public/

# Not needed to build.
.git/
.github/
verification/live-*.db
**/.DS_Store
Thumbs.db
