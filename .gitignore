# dependencies
node_modules/

# build output
dist/
build/
*.tsbuildinfo
# the client bundle the Docker runner copies into the image; built, not committed
server/public/
coverage/
.vite/

# secrets — never commit a real key; rotate anything that was ever pasted/shared
.env
.env.*
!.env.example

# private cache & local databases (never commit real Qloo data)
server/.private-cache/
.private-cache/
*.sqlite
*.sqlite-journal
*.db
*.db-journal
*.db-wal
*.db-shm
*-wal
*-shm

# server/verification/*.json stays tracked on purpose: counts, statuses,
# parameter names and one synthetic replay-derived export — no Qloo entity names,
# entity ids or response payloads (the files say so in their own provenance).
# CoverageBoard reads two of them at runtime. Everything Qloo actually returned
# lives in the *.db live captures above, which the rules already keep out.

# logs and local test artifacts
*.log
npm-debug.log*
server/tests/vitest.json

# large media (demo recordings live outside the repo until re-recorded)
*.mp4
*.mov
*.webm

# OS
.DS_Store
Thumbs.db
