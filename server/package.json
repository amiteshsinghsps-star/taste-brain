{
  "name": "neutronz-server",
  "version": "1.0.0",
  "description": "Company Brain API: FalkorDB per-tenant knowledge graph, graph-first retrieval with decision traces, deterministic rule engine, agent memory and MCP tool server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "mcp": "ts-node src/mcp/server.ts",
    "eval": "tsx src/eval/run.ts",
    "e2e:v3": "tsx src/eval/e2e-v3.ts",
    "trace:check": "tsx src/eval/trace-check.ts",
    "test:removal": "tsx src/eval/removal-test.ts",
    "test:graph": "vitest run tests/graph-v3.test.ts",
    "seed:demo": "tsx src/eval/seed-demo.ts",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=json --outputFile=tests/vitest.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "keywords": [
    "auth",
    "ingestion",
    "composio",
    "jwt",
    "argon2",
    "prisma",
    "postgresql",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@composio/core": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "axios": "^1.7.7",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "falkordb": "^6.8.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
