{
  "name": "taste-brain-server",
  "version": "0.1.0",
  "description": "Taste Brain API: Qloo-grounded decision agents with a Decision Trace, Grounding Auditor, Taste Lift eval and a SQLite graph store.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "eval": "tsx src/eval/run-cli.ts",
    "qloo:smoke": "tsx scripts/qloo-smoke.ts",
    "warm-cache": "tsx scripts/warm-cache.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default",
    "smoke:replay": "tsx scripts/replay-smoke.ts",
    "gate:public": "tsx scripts/public-gate.ts",
    "verify": "tsx scripts/verify.ts",
    "verify:sample": "tsx scripts/make-sample-export.ts",
    "ledger:anchor": "tsx scripts/ledger-anchor.ts",
    "overlay:bundle": "tsx scripts/overlay-bundle.ts",
    "gate:venue": "tsx scripts/venue-gate.ts",
    "verify:qloo": "tsx scripts/probe-config.ts"
  },
  "keywords": [
    "qloo",
    "agents",
    "knowledge-graph",
    "decision-trace"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
