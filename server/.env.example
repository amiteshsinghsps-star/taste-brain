# Taste Brain server configuration.
# Copy to server/.env . No real secrets belong in this file; never commit .env.

PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Where results come from: replay | cached | live.
# replay = offline from committed SYNTHETIC sample fixtures (default, no credential).
# live   = real calls to Qloo via direct REST (requires QLOO_API_KEY below).
DEFAULT_MODE=replay

# License-safe SQLite graph. :memory: works for the demo; point at a file to persist.
GRAPH_DB=:memory:

# ─── QLOO DIRECT REST ────────────────────────────────────────────────────────
# Set QLOO_ENABLED=true and provide QLOO_API_KEY to run in Live mode.
# The key must NEVER reach client code, API responses, tests, or be logged.
QLOO_ENABLED=false
# QLOO_API_KEY=your-key-here          <- fill in server/.env, never here

# Non-secret tuning knobs (safe to commit):
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_THROTTLE_MS=250
QLOO_TIMEOUT_MS=15000
QLOO_MAX_CALLS_PER_REQUEST=8
QLOO_DAILY_SOFT_LIMIT=500

# Private cache directory (gitignored; never committed). Relative to server/.
QLOO_PRIVATE_CACHE_DIR=.private-cache

# ─── PACK IDENTITY OVERLAY (same secrecy class as the key) ──────────────────
# Committed packs name fictional companies, fictional rooms and symbolic
# qloo:brand:* ids. Live mode needs the real Qloo entity ids and the real names
# to search for, so those live in one gitignored overlay per pack:
#   server/.private-data/retail.overlay.json
# Only the key custodian's machine and the deployed host hold them. Without an
# overlay everything still runs; live mode simply finds no offer on file and
# labels those candidates unsupported instead of guessing terms.
# A host that cannot upload files can carry the whole set instead, as base64 of
# {"retail":{...},"venues":{...},"restaurants":{...}} — never in the repo.
PACK_OVERLAY_DIR=.private-data
# PACK_OVERLAY_B64=

# Quota Guardian (F41). Live traffic stops before the shared key is exhausted.
QUOTA_VISITOR_HOUR=8
QUOTA_VISITOR_DAY=40
QUOTA_GLOBAL_DAY=400
QUOTA_MONTHLY_FLOOR=1500

# Finals Mode (F48) and live exports. Set in the host environment, never in the UI.
FINALS_OVERRIDE=false
# Exports and receipts carry Qloo-returned names, so live ones stay refused
# until Qloo confirms what may be shared.
EXPORT_ALLOW_LIVE=false

# Optional LLM. Only writes explanations and runs the Taste Lift "plain LLM" arm.
# It never decides the ranking. Without a key, Taste Lift publishes Arm B only and
# explicitly says Arm A did not run (no fabricated numbers).
# LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Public-demo safety.
RATE_LIMIT_PER_MIN=30
