# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL) — users, tokens, sync state, audit
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/Neutronz_auth?schema=public"

# JWT Secrets (In production, long random cryptographic strings are REQUIRED —
# the server refuses to start in production with the defaults)
JWT_ACCESS_SECRET="Neutronz_access_secret_key_change_in_production_32bytes"
JWT_REFRESH_SECRET="Neutronz_refresh_secret_key_change_in_production_32bytes"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Configuration
CLIENT_ORIGIN="http://localhost:3000"

# FalkorDB — the Company Brain graph store (one isolated graph per tenant).
# With `docker compose up -d` at the repo root, defaults below work as-is.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_PASSWORD=          # only for FalkorDB Cloud or ACL-protected servers
# FALKORDB_USERNAME=

# Embeddings (merge with FalkorDB vector index — keep EMBEDDINGS_DIM equal to
# your model's output dimension; the INDEX is created with EMBEDDINGS_DIM)
OPENAI_API_KEY="sk-proj-your_openai_or_llm_api_key_here"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
EMBEDDINGS_MODEL="text-embedding-3-small"
EMBEDDINGS_DIM=256

# MCP server (optional): the tenant the MCP tool server operates on
# NEUTRONZ_TENANT_ID=

# Optional alternates / provenance (the app runs without any of these):
# LLM_API_KEY=              # alias for OPENAI_API_KEY, either one is accepted
# COMPOSIO_API_KEY=         # live Gmail/Drive/Slack connectors; unset = clearly-labeled mock connectors
# GIT_COMMIT=               # stamped into eval/results.json and /api/status so numbers are traceable
                            # (the repo ships as a zip, so it defaults to "dev")

# Feature flags (all default OFF — the demo is synthetic-data only):
# FF_LIVE_CONNECTORS=1      # allow POST /api/ingestion/sources + :id/sync to reach real
                            # Gmail/Drive/Slack/SQL accounts. Without it those routes answer
                            # 403 LIVE_CONNECTORS_DISABLED and the UI shows a banner. Uploads
                            # and "Load demo company" keep working either way.
# FALKORDB_REQUIRED=1       # test suites fail instead of skipping when the graph is down
                            # (this is what CI sets; see .github/workflows/ci.yml)
